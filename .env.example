# Kopieren nach .env und anpassen. Alle Parameter: batterieoptimizer/config.py
# (Umgebungsvariable = Feldname in Großbuchstaben).

# Erst nach einer Woche Dry-Run auf false stellen
DRY_RUN=true

EVCC_URL=http://localhost:7070
# Nur nötig, wenn evcc für POST/DELETE ein Admin-Login verlangt
# EVCC_PASSWORD=

MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Müssen zu Ziel-SoC und Ladeleistung passen, die HA beim Netzladen setzt
TARGET_SOC=80
CHARGE_POWER_W=3000

# Abschlag auf die evcc-PV-Prognose (siehe /data/pv_log.jsonl zum Kalibrieren)
PV_FACTOR=0.8
